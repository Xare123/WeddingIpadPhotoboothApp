{
  "expo": {
    "name": "Wedding Photobooth",
    "slug": "wedding-ipad-photobooth",
    "version": "0.3.5",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "8",
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.example.weddingphotobooth",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Save your wedding photos to this iPad\u2019s Photos library."
      }
    },
    "plugins": [
      "../../plugins/with-full-photo.cjs",
      [
        "expo-camera",
        {
          "cameraPermission": "Use the front camera to take your wedding photobooth photo.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Authenticate the booth host before changing photo sharing settings."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Save your wedding photos to this iPad\u2019s Photos library.",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
