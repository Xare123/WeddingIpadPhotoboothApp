{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wedding-photobooth-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "photobooth-local" }],
  "vars": {
    "MODE": "local",
    "SMS_MODE": "mock",
    "LINK_TTL_SECONDS": "86400",
    "LOCAL_DEVICE_TOKEN": "local-development-only",
    "LOCAL_LINK_KEY": "local-link-key-not-for-production"
  },
  "observability": { "enabled": false },
  "send_metrics": false
}
